{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mikknikk.github.io/aiheseurain/schemas/julkaisukohde.schema.json",
  "title": "Julkaisukohteen määritys",
  "type": "object",
  "required": [
    "publication_id",
    "publication_version",
    "publication_type",
    "name",
    "status",
    "destination"
  ],
  "properties": {
    "publication_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "publication_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "publication_type": {
      "enum": [
        "rss"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "active",
        "inactive"
      ]
    },
    "destination": {
      "type": "object",
      "required": [
        "format",
        "path",
        "url"
      ],
      "properties": {
        "format": {
          "const": "rss-2.0"
        },
        "path": {
          "type": "string",
          "pattern": "^feeds/[a-z0-9][a-z0-9-]*\\.xml$"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
