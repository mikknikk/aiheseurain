{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mikknikk.github.io/aiheseurain/schemas/target-report.schema.json",
  "title": "Seurantakohteen raportti",
  "type": "object",
  "required": [
    "report_schema_version",
    "target_id",
    "target_version",
    "observation_types",
    "period",
    "checked_at",
    "report_content"
  ],
  "properties": {
    "report_schema_version": {
      "const": 1
    },
    "target_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "target_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "observation_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "period": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "string", "format": "date-time"},
        "end": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "checked_at": {
      "type": "string",
      "format": "date-time"
    },
    "report_content": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}