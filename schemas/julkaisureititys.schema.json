{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mikknikk.github.io/aiheseurain/schemas/julkaisureititys.schema.json",
  "title": "Havaintojen julkaisureititys",
  "type": "object",
  "required": [
    "routing_version",
    "routes"
  ],
  "properties": {
    "routing_version": {
      "const": "1.0.0"
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "route_id",
          "module_ref",
          "target_ref",
          "publication_refs",
          "observation_types",
          "status"
        ],
        "properties": {
          "route_id": {
            "type": "string"
          },
          "module_ref": {
            "type": "string"
          },
          "target_ref": {
            "type": "string"
          },
          "publication_refs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "observation_types": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "status": {
            "enum": [
              "active",
              "inactive"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
