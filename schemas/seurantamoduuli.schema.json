{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mikknikk.github.io/aiheseurain/schemas/seurantamoduuli.schema.json",
  "title": "Aiheseuraimen seurantamoduulin tietosopimus",
  "description": "Seurantamoduulin suoritus-, kyvykkyys-, lähde- ja toimituksellinen sopimus. Seurantakohteiden hakuehdot ja julkaisukohteiden tekniset asetukset määritellään erillisissä sopimuksissa.",
  "type": "object",
  "required": [
    "contract_version",
    "module_id",
    "module_type",
    "definition_version",
    "name",
    "description",
    "capabilities",
    "interfaces",
    "source_refs",
    "editorial_rules",
    "target_refs"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0.0",
      "description": "Tämän yhteisen tietosopimuksen versio; ei ole moduulin määritysversion tunniste."
    },
    "module_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
      "maxLength": 120,
      "description": "Pysyvä tekninen tunniste. Nimeä tai kuvausta ei käytetä viittausavaimena."
    },
    "module_type": {
      "enum": [
        "topic",
        "process"
      ]
    },
    "definition_version": {
      "$ref": "#/$defs/semanticVersion",
      "description": "Tämän moduulin muuttumattoman määritysjulkaisun semanttinen versio."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "replaces": {
      "type": "array",
      "description": "Uuden moduulitunnisteen korvaamat aiemmat moduulit. Ei muuta vanhojen ajojen viittauksia.",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/capabilityRequirement"
      },
      "uniqueItems": true
    },
    "interfaces": {
      "type": "object",
      "required": [
        "input",
        "output"
      ],
      "properties": {
        "input": {
          "$ref": "#/$defs/interfaceContract"
        },
        "output": {
          "$ref": "#/$defs/interfaceContract"
        }
      },
      "additionalProperties": false
    },
    "source_refs": {
      "type": "array",
      "description": "Viittaukset yhteiseen lähdekatalogiin; lähteen perustietoja ei kopioida moduuliin.",
      "items": {
        "$ref": "#/$defs/sourceReference"
      },
      "uniqueItems": true
    },
    "editorial_rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/editorialRule"
      }
    },
    "process_extension": {
      "$ref": "#/$defs/processExtension"
    },
    "target_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
      },
      "description": "Viitteet erillisiin seurantakohteisiin. Hakuehdot eivät kuulu moduulimäärittelyyn."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "module_type": {
            "const": "topic"
          }
        },
        "required": [
          "module_type"
        ]
      },
      "then": {
        "required": [
          "topic"
        ],
        "not": {
          "required": [
            "process_extension"
          ]
        }
      },
      "else": {
        "required": [
          "process_extension"
        ],
        "not": {
          "required": [
            "topic"
          ]
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "capabilityRequirement": {
      "type": "object",
      "required": [
        "id",
        "minimum_version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
        },
        "minimum_version": {
          "$ref": "#/$defs/semanticVersion"
        },
        "required": {
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false
    },
    "interfaceContract": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
        },
        "version": {
          "$ref": "#/$defs/semanticVersion"
        }
      },
      "additionalProperties": false
    },
    "sourceReference": {
      "type": "object",
      "required": [
        "source_id",
        "role"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "role": {
          "enum": [
            "primary",
            "secondary",
            "discovery",
            "verification"
          ]
        },
        "required": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "editorialRule": {
      "type": "object",
      "required": [
        "id",
        "category",
        "instruction"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
        },
        "category": {
          "enum": [
            "inclusion",
            "exclusion",
            "verification",
            "reporting",
            "uncertainty"
          ]
        },
        "instruction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "severity": {
          "enum": [
            "required",
            "recommended",
            "informational"
          ],
          "default": "required"
        }
      },
      "additionalProperties": false
    },
    "processExtension": {
      "type": "object",
      "required": [
        "extension_id",
        "extension_version",
        "schema_uri",
        "configuration"
      ],
      "properties": {
        "extension_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
        },
        "extension_version": {
          "$ref": "#/$defs/semanticVersion"
        },
        "schema_uri": {
          "type": "string",
          "format": "uri"
        },
        "configuration": {
          "type": "object",
          "description": "Laajennuksen oma sisältö validoidaan schema_uri-kentän osoittamaa, versionoitua skeemaa vasten."
        }
      },
      "additionalProperties": false
    }
  }
}
