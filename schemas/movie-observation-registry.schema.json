{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mikknikk.github.io/aiheseurain/schemas/movie-observation-registry.schema.json",
  "title": "Elokuvahavaintojen elokuvatason rekisteri",
  "type": "object",
  "required": [
    "schema_version",
    "films"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "films": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/movie"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "publisher",
        "url",
        "checked_at",
        "claim_level"
      ],
      "properties": {
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "checked_at": {
          "type": "string",
          "format": "date-time"
        },
        "claim_level": {
          "enum": [
            "official",
            "organizer",
            "third_party",
            "unknown"
          ]
        }
      },
      "additionalProperties": false
    },
    "externalId": {
      "type": "object",
      "required": [
        "provider",
        "value"
      ],
      "properties": {
        "provider": {
          "enum": [
            "imdb",
            "tmdb"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "criterionMatch": {
      "type": "object",
      "required": [
        "match_id",
        "criterion_id",
        "criterion_version",
        "first_matched_at",
        "last_matched_at",
        "reasons",
        "source_urls"
      ],
      "properties": {
        "match_id": {
          "type": "string",
          "minLength": 1
        },
        "criterion_id": {
          "type": "string",
          "minLength": 1
        },
        "criterion_version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "first_matched_at": {
          "type": "string",
          "format": "date-time"
        },
        "last_matched_at": {
          "type": "string",
          "format": "date-time"
        },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_urls": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "additionalProperties": false
    },
    "movie": {
      "type": "object",
      "required": [
        "movie_id",
        "primary_title",
        "aliases",
        "release_year",
        "external_ids",
        "first_seen_at",
        "last_seen_at",
        "identity_confidence",
        "needs_review",
        "screening_refs",
        "sources",
        "criterion_matches"
      ],
      "properties": {
        "movie_id": {
          "type": "string",
          "minLength": 1
        },
        "primary_title": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "release_year": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1888,
          "maximum": 2200
        },
        "external_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/externalId"
          }
        },
        "first_seen_at": {
          "type": "string",
          "format": "date-time"
        },
        "last_seen_at": {
          "type": "string",
          "format": "date-time"
        },
        "identity_confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "needs_review": {
          "type": "boolean"
        },
        "screening_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "criterion_matches": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/criterionMatch"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
