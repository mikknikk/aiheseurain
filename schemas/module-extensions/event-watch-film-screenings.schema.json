{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mikknikk.github.io/aiheseurain/schemas/module-extensions/event-watch-film-screenings.schema.json",
  "title": "Elokuvanäytösten tapahtumavahtilaajennus",
  "x-extension-id": "event-watch.film-screenings",
  "x-extension-version": "1.0.0",
  "description": "Esimerkki prosessimoduulin omasta, erikseen validoitavasta laajennuksesta. Ei määrittele vielä yleistä tapahtumavahtimoottoria.",
  "type": "object",
  "required": ["event_types", "geography", "identity", "history"],
  "properties": {
    "event_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "const": "film_screening" }
    },
    "geography": {
      "type": "object",
      "required": ["country"],
      "properties": {
        "country": { "const": "FI" },
        "regions": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "identity": {
      "type": "object",
      "required": ["event_key_fields"],
      "properties": {
        "event_key_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["film", "venue", "start_time", "screen"] }
        },
        "uncertain_match_policy": { "const": "do_not_merge_automatically" }
      },
      "additionalProperties": false
    },
    "history": {
      "type": "object",
      "required": ["retain_changes", "retain_cancelled"],
      "properties": {
        "retain_changes": { "const": true },
        "retain_cancelled": { "const": true }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
