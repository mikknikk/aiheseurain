{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChatGPT module result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "module_id",
    "module_definition_version",
    "contract_version",
    "run_id",
    "period",
    "status",
    "source_scan_complete",
    "checked_at",
    "handoff"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "module_id": {
      "type": "string",
      "minLength": 1
    },
    "module_definition_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "contract_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "period": {
      "$ref": "#/$defs/period"
    },
    "status": {
      "enum": [
        "succeeded",
        "partial",
        "failed"
      ]
    },
    "source_scan_complete": {
      "type": "boolean"
    },
    "checked_at": {
      "type": "string",
      "format": "date-time"
    },
    "report_content": {
      "type": "string",
      "minLength": 1
    },
    "sources_checked": {
      "type": "integer",
      "minimum": 0
    },
    "source_check_run_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "report_guid_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "artifacts": {
      "type": "object"
    },
    "metadata": {
      "type": "object"
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dispatch_schema_version",
        "module_id",
        "module_definition_version",
        "contract_version",
        "run_id",
        "period",
        "requested_at",
        "input_sha256"
      ],
      "properties": {
        "dispatch_schema_version": {
          "const": 1
        },
        "module_id": {
          "type": "string",
          "minLength": 1
        },
        "module_definition_version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "contract_version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
        },
        "period": {
          "$ref": "#/$defs/period"
        },
        "requested_at": {
          "type": "string",
          "format": "date-time"
        },
        "input_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "target_reports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target_id",
          "target_version",
          "observation_types",
          "period",
          "checked_at",
          "report_content"
        ],
        "properties": {
          "target_id": {
            "type": "string",
            "minLength": 1
          },
          "target_version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
          },
          "observation_types": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "period": {
            "$ref": "#/$defs/period"
          },
          "checked_at": {
            "type": "string",
            "format": "date-time"
          },
          "report_content": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  },
  "anyOf": [
    {
      "required": [
        "report_content"
      ]
    },
    {
      "required": [
        "target_reports"
      ]
    }
  ]
}
