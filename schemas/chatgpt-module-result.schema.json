{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChatGPT module result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "module_id",
    "module_definition_version",
    "contract_version",
    "run_id",
    "period",
    "status",
    "source_scan_complete",
    "checked_at",
    "handoff"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "module_id": {
      "type": "string",
      "minLength": 1
    },
    "module_definition_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "contract_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "period": {
      "$ref": "#/$defs/period"
    },
    "status": {
      "enum": [
        "succeeded",
        "partial",
        "failed"
      ]
    },
    "source_scan_complete": {
      "type": "boolean"
    },
    "checked_at": {
      "type": "string",
      "format": "date-time"
    },
    "report_content": {
      "type": "string",
      "minLength": 1
    },
    "sources_checked": {
      "type": "integer",
      "minimum": 0
    },
    "source_check_run_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "report_guid_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "artifacts": {
      "type": "object"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "publication_assessment": {
          "$ref": "#/$defs/publication_assessment"
        }
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dispatch_schema_version",
        "module_id",
        "module_definition_version",
        "contract_version",
        "run_id",
        "period",
        "requested_at",
        "input_sha256"
      ],
      "properties": {
        "dispatch_schema_version": {
          "const": 1
        },
        "module_id": {
          "type": "string",
          "minLength": 1
        },
        "module_definition_version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "contract_version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
        },
        "period": {
          "$ref": "#/$defs/period"
        },
        "requested_at": {
          "type": "string",
          "format": "date-time"
        },
        "input_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "target_reports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target_id",
          "target_version",
          "observation_types",
          "period",
          "checked_at",
          "report_content"
        ],
        "properties": {
          "target_id": {
            "type": "string",
            "minLength": 1
          },
          "target_version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
          },
          "observation_types": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "period": {
            "$ref": "#/$defs/period"
          },
          "checked_at": {
            "type": "string",
            "format": "date-time"
          },
          "report_content": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "publication_assessment": {
      "type": "object",
      "required": [
        "checklist",
        "decision",
        "reviewer_notes",
        "claim_assessments"
      ],
      "properties": {
        "checklist": {
          "type": "object",
          "required": [
            "sources_opened",
            "claim_support",
            "source_independence",
            "uncertainty",
            "dates",
            "tracking_period",
            "duplicates",
            "guid_preservation",
            "xml_html",
            "rss_structure",
            "report_completeness",
            "accessibility"
          ],
          "properties": {
            "sources_opened": {
              "$ref": "#/$defs/publication_assessment/$defs/check"
            },
            "claim_support": {
              "$ref": "#/$defs/publication_assessment/$defs/check"
            },
            "source_independence": {
              "$ref": "#/$defs/publication_assessment/$defs/check"
            },
            "uncertainty": {
              "$ref": "#/$defs/publication_assessment/$defs/check"
            },
            "dates": {
              "$ref": "#/$defs/publication_assessment/$defs/check"
            },
            "tracking_period": {
              "$ref": "#/$defs/publication_assessment/$defs/check"
            },
            "duplicates": {
              "$ref": "#/$defs/publication_assessment/$defs/check"
            },
            "guid_preservation": {
              "$ref": "#/$defs/publication_assessment/$defs/check"
            },
            "xml_html": {
              "$ref": "#/$defs/publication_assessment/$defs/check"
            },
            "rss_structure": {
              "$ref": "#/$defs/publication_assessment/$defs/check"
            },
            "report_completeness": {
              "$ref": "#/$defs/publication_assessment/$defs/check"
            },
            "accessibility": {
              "$ref": "#/$defs/publication_assessment/$defs/check"
            }
          },
          "additionalProperties": false,
          "allOf": [
            {
              "properties": {
                "sources_opened": {
                  "required": [
                    "evidence"
                  ],
                  "properties": {
                    "evidence": {
                      "minItems": 1
                    }
                  }
                }
              }
            },
            {
              "properties": {
                "claim_support": {
                  "required": [
                    "evidence"
                  ],
                  "properties": {
                    "evidence": {
                      "minItems": 1
                    }
                  }
                }
              }
            },
            {
              "properties": {
                "source_independence": {
                  "required": [
                    "evidence"
                  ],
                  "properties": {
                    "evidence": {
                      "minItems": 1
                    }
                  }
                }
              }
            }
          ]
        },
        "decision": {
          "enum": [
            "approved",
            "rejected"
          ]
        },
        "reviewer_notes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "claim_assessments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/publication_assessment/$defs/claim_assessment"
          }
        }
      },
      "additionalProperties": false,
      "$defs": {
        "check": {
          "type": "object",
          "required": [
            "status",
            "note"
          ],
          "properties": {
            "status": {
              "enum": [
                "pass",
                "fail",
                "not_applicable"
              ]
            },
            "note": {
              "type": "string"
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "not_applicable"
                  }
                },
                "required": [
                  "status"
                ]
              },
              "then": {
                "properties": {
                  "note": {
                    "minLength": 5
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "fail"
                  }
                },
                "required": [
                  "status"
                ]
              },
              "then": {
                "properties": {
                  "note": {
                    "minLength": 5
                  }
                }
              }
            }
          ],
          "additionalProperties": false
        },
        "claim_assessment": {
          "type": "object",
          "required": [
            "claim_id",
            "claim",
            "verification_status",
            "sources"
          ],
          "properties": {
            "claim_id": {
              "type": "string",
              "minLength": 1
            },
            "claim": {
              "type": "string",
              "minLength": 1
            },
            "verification_status": {
              "enum": [
                "ensisijaislahteella_vahvistettu",
                "riippumattomissa_toimituksellisissa_lahteissa_vahvistettu",
                "yhden_toimituksellisen_lahteen_raportoima",
                "nimettomaan_lahteeseen_perustuva",
                "huhu",
                "ristiriitainen_tai_selvittamaton"
              ]
            },
            "sources": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "source_id",
                  "source_class",
                  "source_role",
                  "independence"
                ],
                "properties": {
                  "source_id": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9-]*$"
                  },
                  "source_class": {
                    "enum": [
                      "A",
                      "B",
                      "C",
                      "D"
                    ]
                  },
                  "source_role": {
                    "enum": [
                      "ensisijainen",
                      "toimituksellinen",
                      "nimetty_asiantuntija",
                      "anonyymi_tietolahde",
                      "some_tai_yhteiso",
                      "muu"
                    ]
                  },
                  "independence": {
                    "enum": [
                      "riippumaton",
                      "sama_alkupera",
                      "ei_sovellu",
                      "tuntematon"
                    ]
                  },
                  "note": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            },
            "note": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      }
    }
  },
  "anyOf": [
    {
      "required": [
        "report_content"
      ]
    },
    {
      "required": [
        "target_reports"
      ]
    }
  ]
}
