{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aihekohtainen lähderekisteri (yhteinen skeema)",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "updated_at",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      },
      "uniqueItems": true
    },
    "task_id": {
      "enum": [
        "tolkien",
        "taylor_swift",
        "gurmeet_ram_rahim_singh",
        "muumit",
        "wakaliwood",
        "euroviisut",
        "sompote_sands",
        "shakkidraamat",
        "intialaiset_elokuvat_uutiset",
        "intialaiset_elokuvat_naytokset"
      ]
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "id",
        "name",
        "url",
        "language_regions",
        "source_type",
        "critical",
        "last_checked_at",
        "access_limit",
        "regions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "language_regions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "source_type": {
          "enum": [
            "primary",
            "editorial",
            "other"
          ]
        },
        "critical": {
          "type": "boolean"
        },
        "last_checked_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "access_limit": {
          "type": [
            "string",
            "null"
          ]
        },
        "regions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2
          }
        }
      },
      "additionalProperties": false
    }
  }
}
