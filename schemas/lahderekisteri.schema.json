{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aihekohtainen lähdekäyttörekisteri",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "updated_at",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "task_id": {
      "enum": [
        "tolkien",
        "taylor_swift",
        "gurmeet_ram_rahim_singh",
        "muumit",
        "wakaliwood",
        "euroviisut",
        "sompote_sands",
        "shakkidraamat",
        "intialaiset_elokuvat_uutiset",
        "intialaiset_elokuvat_naytokset"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assignment"
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "assignment": {
      "type": "object",
      "required": [
        "source_id",
        "critical",
        "last_checked_at",
        "access_limit",
        "retry_after"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "critical": {
          "type": "boolean"
        },
        "last_checked_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "access_limit": {
          "type": [
            "string",
            "null"
          ]
        },
        "retry_after": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "additionalProperties": false
    }
  }
}
