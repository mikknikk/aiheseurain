{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mikknikk.github.io/aiheseurain/schemas/module-run-result.schema.json",
  "title": "Yhteisen moduuliajon jäljitettävä tulos",
  "type": "object",
  "required": [
    "schema_version",
    "module_id",
    "module_type",
    "module_definition_version",
    "contract_version",
    "run_id",
    "period",
    "mode",
    "status",
    "phase",
    "started_at",
    "finished_at",
    "source_scan_complete",
    "quality_passed",
    "published",
    "checkpoint_updated",
    "comparison",
    "error_code"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "module_id": {
      "type": "string",
      "minLength": 1
    },
    "module_type": {
      "enum": [
        "topic",
        "process"
      ]
    },
    "module_definition_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "contract_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "run_id": {
      "type": "string",
      "minLength": 3
    },
    "period": {
      "type": "object",
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "mode": {
      "enum": [
        "shadow",
        "production"
      ]
    },
    "status": {
      "enum": [
        "succeeded",
        "partial",
        "failed",
        "rejected"
      ]
    },
    "phase": {
      "enum": [
        "request_validation",
        "module_resolution",
        "execution",
        "quality_gate",
        "shadow_comparison",
        "publication",
        "artifact_persistence",
        "checkpoint",
        "complete"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_scan_complete": {
      "type": "boolean"
    },
    "quality_passed": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "published": {
      "type": "boolean"
    },
    "checkpoint_updated": {
      "type": "boolean"
    },
    "comparison": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "equivalent",
            "summary"
          ],
          "properties": {
            "equivalent": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "summary": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "error_code": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    }
  },
  "additionalProperties": false
}
