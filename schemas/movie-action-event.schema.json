{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://mikknikk.github.io/aiheseurain/schemas/movie-action-event.schema.json","title":"Elokuvahavainnon jatkotoimen versionoitu tapahtuma","type":"object","required":["schema_version","event_type","movie_id","title","release_year","first_seen_at","criterion_id","action_id","action_version","screening_refs","source_urls"],"properties":{"schema_version":{"const":1},"event_type":{"const":"movie_first_observed"},"movie_id":{"type":"string","minLength":1},"title":{"type":"string","minLength":1},"release_year":{"type":["integer","null"],"minimum":1888,"maximum":2200},"first_seen_at":{"type":"string","format":"date-time"},"criterion_id":{"type":"string","minLength":1},"action_id":{"type":"string","minLength":1},"action_version":{"type":"string","pattern":"^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},"screening_refs":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},"source_urls":{"type":"array","uniqueItems":true,"items":{"type":"string","format":"uri"}}},"additionalProperties":false}
