{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mikknikk.github.io/aiheseurain/schemas/seurantakohderekisteri.schema.json",
  "title": "Seurantakohderekisteri",
  "type": "object",
  "required": [
    "registry_version",
    "targets"
  ],
  "properties": {
    "registry_version": {
      "const": "1.0.0"
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "target_id",
          "path",
          "status"
        ],
        "properties": {
          "target_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
          },
          "path": {
            "type": "string",
            "pattern": "^data/targets/[a-z0-9.-]+\\.json$"
          },
          "status": {
            "enum": [
              "active",
              "inactive"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
