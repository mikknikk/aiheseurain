{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mikknikk.github.io/aiheseurain/schemas/module-run-request.schema.json",
  "title": "Yhteinen seurantamoduulin suorituspyyntö",
  "type": "object",
  "required": [
    "schema_version",
    "module_id",
    "module_definition_version",
    "contract_version",
    "run_id",
    "period",
    "mode",
    "requested_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "module_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "module_definition_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "contract_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{2,127}$"
    },
    "period": {
      "type": "object",
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "mode": {
      "enum": [
        "shadow",
        "production"
      ]
    },
    "requested_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
