{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mikknikk.github.io/aiheseurain/schemas/taylor-swift-shadow-result.schema.json",
  "title": "Taylor Swift -varjoharjoituksen tulosartefakti",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_type", "status", "module_id",
    "module_definition_version", "run_id", "period", "approval_reference",
    "preparation_input_sha256", "chatgpt_result_sha256", "research_performed",
    "publication_performed", "production_state_written", "result", "recorded_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "artifact_type": {"const": "taylor_swift_shadow_result"},
    "status": {"enum": ["succeeded", "partial", "failed"]},
    "module_id": {"const": "taylor-swift"},
    "module_definition_version": {"type": "string"},
    "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{7,127}$"},
    "period": {
      "type": "object", "required": ["start", "end"],
      "properties": {
        "start": {"type": "string", "format": "date-time"},
        "end": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "approval_reference": {"type": "string", "minLength": 1},
    "preparation_input_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "chatgpt_result_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "research_performed": {"const": true},
    "publication_performed": {"const": false},
    "production_state_written": {"const": false},
    "result": {"type": "object"},
    "recorded_at": {"type": "string", "format": "date-time"}
  }
}
