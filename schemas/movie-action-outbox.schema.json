{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mikknikk.github.io/aiheseurain/schemas/movie-action-outbox.schema.json",
  "title": "Elokuvahavaintojen jatkotoimien toimitusjono",
  "type": "object",
  "required": [
    "schema_version",
    "actions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "event_id",
          "idempotency_key",
          "criterion_id",
          "action_id",
          "action_version",
          "action_type",
          "movie_id",
          "payload",
          "status",
          "attempts",
          "created_at",
          "updated_at",
          "sent_at",
          "last_error_code",
          "next_attempt_at"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "minLength": 1
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 1
          },
          "criterion_id": {
            "type": "string",
            "minLength": 1
          },
          "action_id": {
            "type": "string",
            "minLength": 1
          },
          "action_version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
          },
          "action_type": {
            "enum": [
              "discord_webhook"
            ]
          },
          "movie_id": {
            "type": "string",
            "minLength": 1
          },
          "payload": {
            "type": "object",
            "required": [
              "schema_version",
              "event_type",
              "movie_id",
              "title",
              "release_year",
              "first_seen_at",
              "criterion_id",
              "action_id",
              "action_version",
              "screening_refs",
              "source_urls",
              "screening_observations"
            ],
            "properties": {
              "schema_version": {
                "const": 1
              },
              "event_type": {
                "const": "movie_first_observed"
              },
              "movie_id": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "release_year": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1888,
                "maximum": 2200
              },
              "first_seen_at": {
                "type": "string",
                "format": "date-time"
              },
              "criterion_id": {
                "type": "string",
                "minLength": 1
              },
              "action_id": {
                "type": "string",
                "minLength": 1
              },
              "action_version": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
              },
              "screening_refs": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "source_urls": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "format": "uri"
                },
                "minItems": 1
              },
              "screening_observations": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "screening_id",
                    "title",
                    "venue",
                    "city",
                    "starts_at",
                    "status",
                    "source_urls"
                  ],
                  "properties": {
                    "screening_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "title": {
                      "type": "string",
                      "minLength": 1
                    },
                    "venue": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "city": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "starts_at": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "format": "date-time"
                    },
                    "status": {
                      "type": "string",
                      "minLength": 1
                    },
                    "source_urls": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "format": "uri"
                      }
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          },
          "status": {
            "enum": [
              "pending",
              "sent",
              "failed",
              "uncertain"
            ]
          },
          "attempts": {
            "type": "integer",
            "minimum": 0
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "sent_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "last_error_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "next_attempt_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
