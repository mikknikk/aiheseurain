  "editorial_rules": [
    {
      "id": "local-script-search",
      "category": "inclusion",
      "instruction": "Hae paikallisilla kirjoitusjärjestelmillä ja translitteroinneilla, älä vain englanninkielisillä nimillä.",
      "severity": "required"
    },
    {
      "id": "claim-levels",
      "category": "verification",
      "instruction": "Merkitse uutiset virallisesti vahvistetuiksi, median raportoimiksi tai vahvistamattomiksi huhuiksi; erottele arvioidut lipputulot virallisista luvuista.",
      "severity": "required"
    },
    {
      "id": "independent-confirmation",
      "category": "verification",
      "instruction": "Tarkista, perustuvatko eri julkaisut samaan alkuperäislähteeseen; älä laske kopioivia medioita riippumattomiksi vahvistuksiksi.",
      "severity": "required"
    },
    {
      "id": "finland-coverage",
      "category": "inclusion",
      "instruction": "Sisällytä suomalaisen median jutut ja suomalaiset tekijät intialaisissa elokuvissa, mutta älä lisää Suomen näytöslistoja uutisraporttiin.",
      "severity": "required"
    },
    {
      "id": "visual-material",
      "category": "reporting",
      "instruction": "Lisää mahdollisuuksien mukaan oikea virallinen juliste ja elokuvan virallinen YouTube-traileri; älä arvaa tai korvaa fanilatauksella.",
      "severity": "required"
    }
  ],
  "topic": {
    "scope": "Intian elokuvateollisuudet ja niiden eri kielialueet: telugu, tamili, kannada, malajalam, hindi, bengali, marathi, pandžabi sekä assami ja odia silloin kun relevanttia. Seuranta kattaa henkilöt, tuotannot, julkaisut, lipputulot, suoratoiston, festivaalit, palkinnot, alan tapahtumat ja Suomen yhteydet.",
    "include": [
      "Telugu-, tamili-, kannada-, malajalam-, hindi-, bengali-, marathi- ja pandžabielokuvat sekä assamin- ja odian-kielinen elokuva relevantissa laajuudessa",
      "Seurattavat näyttelijät, ohjaajat, tuottajat ja muut elokuvantekijät",
      "Erityisseurattavat projektit ja elokuvasarjat",
      "Julkaisut, lipputulot, suoratoisto, festivaalit, palkinnot ja tuotantouutiset",
      "Suomalaisessa mediassa julkaistut intialaiselokuvia koskevat jutut ja suomalaiset tekijät intialaisissa elokuvissa"
    ],
    "exclude": [
      "Suomen näytösajat ja teatteriohjelmistot, jotka kuuluvat erilliseen näytösvahtiin",
      "Vahvistamattomat huhut esitettyinä virallisina tuotantotietoina",
      "Saman uutisen moninkertainen kirjaaminen eri medioiden kopioidessa samaa alkuperäislähdettä"
    ],
