  "search_profiles": [
    {
      "id": "indian-film-screenings-finland",
      "purpose": "Etsi tulevia, muuttuneita ja menneitä intialaisten elokuvien näytöksiä Suomessa.",
      "query_terms": [
        "Indian film screening Finland",
        "intialainen elokuva näytös",
        "Tamil Telugu Malayalam Hindi film Finland screening",
        "Indian film festival Finland",
        "Finnkino BioRex Kino Regina Cinema Orion Kino Myyri"
      ],
      "languages": [
        "en",
        "fi",
        "ta"
      ],
      "regions": [
        "FI"
      ],
      "notes": "Käytä teatterien ja järjestäjien omia ohjelmistoja ensisijaisina vahvistuksina; kolmannen osapuolen ilmoitukset merkitään omalla vahvistustasollaan."
    }
  ],
  "editorial_rules": [
    {
      "id": "screening-scope",
      "category": "inclusion",
      "instruction": "Sisällytä Suomessa järjestettävät tavalliset, ennakko- ja erikoisnäytökset, festivaalit ja muut yleisölle avoimet intialaisen elokuvan tapahtumat.",
      "severity": "required"
    },
    {
      "id": "screening-source-level",
      "category": "verification",
      "instruction": "Erota teatterin vahvistama, järjestäjän ilmoittama ja kolmannen osapuolen ilmoittama tieto; älä korota vahvistustasoa.",
      "severity": "required"
    },
    {
      "id": "screening-history",
      "category": "reporting",
      "instruction": "Säilytä tulevat, menneet, peruutetut ja muuttuneet näytökset historiassa; siirrä menneet näytösajat raportin erilliseen historiaosioon.",
      "severity": "required"
    },
    {
      "id": "screening-identity",
      "category": "uncertainty",
      "instruction": "Käytä pysyvää näytöstunnistetta ja tarkkaa identiteettiä; älä yhdistä epävarmoja elokuva- tai näytöstunnistuksia automaattisesti.",
      "severity": "required"
    },
    {
      "id": "screening-partial-source",
      "category": "uncertainty",
      "instruction": "Lähteen saavuttamattomuus ei tarkoita ohjelmiston tyhjyyttä eikä aiemmin ilmoitetun näytöksen poistumista.",
      "severity": "required"
    }
  ],
