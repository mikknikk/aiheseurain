  "editorial_rules": [
    {
      "id": "local-script-search",
      "category": "inclusion",
      "instruction": "Hae paikallisilla kirjoitusjärjestelmillä ja translitteroinneilla, älä vain englanninkielisillä nimillä.",
      "severity": "required"
    },
    {
      "id": "claim-levels",
      "category": "verification",
      "instruction": "Merkitse uutiset virallisesti vahvistetuiksi, median raportoimiksi tai vahvistamattomiksi huhuiksi; erottele arvioidut lipputulot virallisista luvuista.",
      "severity": "required"
    },
    {
      "id": "independent-confirmation",
      "category": "verification",
      "instruction": "Tarkista, perustuvatko eri julkaisut samaan alkuperäislähteeseen; älä laske kopioivia medioita riippumattomiksi vahvistuksiksi.",
      "severity": "required"
    },
    {
      "id": "finland-coverage",
      "category": "inclusion",
      "instruction": "Sisällytä suomalaisen median jutut ja suomalaiset tekijät intialaisissa elokuvissa, mutta älä lisää Suomen näytöslistoja uutisraporttiin.",
      "severity": "required"
    },
    {
      "id": "visual-material",
      "category": "reporting",
      "instruction": "Lisää mahdollisuuksien mukaan oikea virallinen juliste ja elokuvan virallinen YouTube-traileri; älä arvaa tai korvaa fanilatauksella.",
      "severity": "required"
    }
  ],
