{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mikknikk.github.io/aiheseurain/schemas/module-production-activation.schema.json",
  "title": "Moduulikohtainen tuotantotilan aktivointi",
  "type": "object",
  "required": [
    "schema_version",
    "modules"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "modules": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "boolean"
      }
    }
  },
  "additionalProperties": false
}
