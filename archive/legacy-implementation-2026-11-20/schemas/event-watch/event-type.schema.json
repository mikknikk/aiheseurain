{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mikknikk.github.io/aiheseurain/schemas/event-watch/event-type.schema.json",
  "title": "Tapahtumatyypin laajennussopimus",
  "type": "object",
  "required": [
    "event_type_id",
    "version",
    "identity_fields",
    "required_attributes",
    "tracked_attributes",
    "status_field",
    "statuses",
    "cancelled_statuses",
    "removed_statuses",
    "completed_statuses"
  ],
  "properties": {
    "event_type_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "identity_fields": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_attributes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "tracked_attributes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "enum": [
          "time_changed",
          "place_changed",
          "details_changed"
        ]
      }
    },
    "status_field": {
      "type": "string",
      "minLength": 1
    },
    "statuses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "cancelled_statuses": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "removed_statuses": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "completed_statuses": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "description": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
