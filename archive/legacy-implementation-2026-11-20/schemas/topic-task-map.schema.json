{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mikknikk.github.io/aiheseurain/schemas/topic-task-map.schema.json",
  "title": "Uutiskierron tehtävien ja aihemoduulien kytkentä",
  "type": "object",
  "required": ["schema_version", "tasks"],
  "properties": {
    "schema_version": {"const": 1},
    "tasks": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "required": ["task_id", "module_id", "module_type", "source_registry_task_id"],
        "properties": {
          "task_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "module_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "module_type": {"const": "topic"},
          "source_registry_task_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
