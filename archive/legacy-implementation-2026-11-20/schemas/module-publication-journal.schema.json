{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mikknikk.github.io/aiheseurain/schemas/module-publication-journal.schema.json",
  "title": "Moduulin julkaisumanifesti",
  "type": "object",
  "required": [
    "module_id",
    "run_id",
    "idempotency_key",
    "report_sha256",
    "artifacts_sha256",
    "state_sha256",
    "artifact_version",
    "publication_targets",
    "period_start",
    "period_end",
    "prepared_at",
    "phase",
    "updated_at",
    "receipt",
    "history"
  ],
  "properties": {
    "module_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,180}$"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "report_sha256": {
      "type": "string",
      "minLength": 1
    },
    "artifacts_sha256": {
      "type": "string",
      "minLength": 1
    },
    "state_sha256": {
      "type": "string",
      "minLength": 1
    },
    "artifact_version": {
      "type": "string",
      "minLength": 1
    },
    "publication_targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "prepared_at": {
      "type": "string",
      "format": "date-time"
    },
    "phase": {
      "enum": [
        "prepared",
        "published",
        "artifacts_persisted",
        "checkpoint_updated"
      ]
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "receipt": {
      "type": [
        "object",
        "null"
      ]
    },
    "history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "phase",
          "updated_at",
          "receipt"
        ],
        "properties": {
          "phase": {
            "enum": [
              "prepared",
              "published",
              "artifacts_persisted",
              "checkpoint_updated"
            ]
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "receipt": {
            "type": [
              "object",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "period_start": {
      "type": "string",
      "format": "date-time"
    },
    "period_end": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
