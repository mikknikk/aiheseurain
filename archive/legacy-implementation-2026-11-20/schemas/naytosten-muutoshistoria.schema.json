{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/mikknikk/aiheseurain/main/schemas/naytosten-muutoshistoria.schema.json",
  "title": "Näytösten muutoshistorian tietomalli",
  "description": "Näytösten nykytilan ja append-only-muutostapahtumien rakenteen tarkistus.",
  "type": "object",
  "required": [
    "schema_version",
    "timezone",
    "baseline_status",
    "notes",
    "screenings",
    "events"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "timezone": {
      "const": "Europe/Helsinki"
    },
    "baseline_status": {
      "enum": [
        "pending_first_verified_run",
        "active"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "screenings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/screening"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "publisher",
        "url",
        "published_at",
        "checked_at",
        "claim_type"
      ],
      "properties": {
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "published_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "checked_at": {
          "type": "string",
          "format": "date-time"
        },
        "claim_type": {
          "type": "string",
          "enum": [
            "TEATTERIN VAHVISTAMA",
            "JÄRJESTÄJÄN ILMOITTAMA",
            "KOLMANNEN OSAPUOLEN ILMOITTAMA"
          ]
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "screening": {
      "type": "object",
      "required": [
        "screening_id",
        "film",
        "venue",
        "city",
        "starts_at",
        "status",
        "source_claim_type",
        "sources"
      ],
      "properties": {
        "screening_id": {
          "type": "string",
          "minLength": 1
        },
        "film": {
          "type": "string",
          "minLength": 1
        },
        "venue": {
          "type": "string",
          "minLength": 1
        },
        "city": {
          "type": "string",
          "minLength": 1
        },
        "starts_at": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "enum": [
            "scheduled",
            "cancelled",
            "removed",
            "completed"
          ]
        },
        "source_claim_type": {
          "type": "string",
          "enum": [
            "TEATTERIN VAHVISTAMA",
            "JÄRJESTÄJÄN ILMOITTAMA",
            "KOLMANNEN OSAPUOLEN ILMOITTAMA"
          ]
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "booking_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "external_show_id": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "subtitles": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "event": {
      "type": "object",
      "required": [
        "event_id",
        "observed_at",
        "type",
        "previous",
        "current",
        "sources",
        "note"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "type": {
          "enum": [
            "baseline_created",
            "added",
            "time_changed",
            "venue_changed",
            "details_changed",
            "cancelled",
            "removed_from_listing",
            "reinstated",
            "correction"
          ]
        },
        "screening_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "previous": {
          "type": [
            "object",
            "null"
          ]
        },
        "current": {
          "type": [
            "object",
            "null"
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "baseline_created"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "current": {
                "type": "object"
              }
            }
          },
          "else": {
            "required": [
              "screening_id"
            ],
            "properties": {
              "screening_id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ],
      "additionalProperties": true
    }
  }
}
