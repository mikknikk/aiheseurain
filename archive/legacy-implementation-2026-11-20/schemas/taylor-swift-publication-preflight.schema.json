{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mikknikk.github.io/aiheseurain/schemas/taylor-swift-publication-preflight.schema.json",
  "title": "Taylor Swift -julkaisutilan ennakkotarkistuksen tulos",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "module_id",
    "period",
    "publication_state",
    "execution_allowed",
    "checked_channels",
    "missing_or_unknown_channels",
    "references",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "module_id": {
      "const": "taylor-swift"
    },
    "period": {
      "type": "object",
      "required": [
        "start",
        "end"
      ],
      "additionalProperties": false,
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "publication_state": {
      "enum": [
        "published",
        "unpublished",
        "unknown",
        "conflict"
      ]
    },
    "execution_allowed": {
      "type": "boolean"
    },
    "checked_channels": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "legacy",
          "runtime",
          "repository_rss",
          "pages"
        ]
      }
    },
    "missing_or_unknown_channels": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "legacy",
          "runtime",
          "repository_rss",
          "pages"
        ]
      }
    },
    "references": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
